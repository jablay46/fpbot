# Copy this file to .env and fill in your values. Never commit .env.

# --- Credentials ---------------------------------------------------------
# Sandbox key (fp_test_...) for practice, live key (fp_live_...) for real
# challenge accounts. Each key only authenticates on its own host.
FP_API_KEY=fp_test_replace_me

# Environment: "sandbox" (default) or "live".
FP_ENV=sandbox

# --- Account & market ----------------------------------------------------
# Leave FP_ACCOUNT_ID empty to auto-select the first active account.
FP_ACCOUNT_ID=

# Multi-asset list. Comma-separated market IDs. When set, FP_MARKET_ID is
# ignored. Max 32 markets (one WebSocket subscription limit).
# Crypto / majors + stocks + indices + commodities + forex, for example:
FP_SYMBOLS=binance|BTCUSDT,binance|ETHUSDT,binance|SOLUSDT,binance|XRPUSDT,hyperliquid|xyz:AAPL,hyperliquid|xyz:SP500,binance|XAUUSDT,hyperliquid|xyz:EUR

# Fallback single market when FP_SYMBOLS is empty.
FP_MARKET_ID=binance|BTCUSDT

# --- Strategy ------------------------------------------------------------
# Recommended: donchian_breakout (channel breakout + ADX regime + EMA trend
# filters). Alternatives: supertrend, ema_cross (the original baseline).
FP_STRATEGY=donchian_breakout
FP_TIMEFRAME=15m
FP_EMA_FAST=12
FP_EMA_SLOW=26
FP_ATR_PERIOD=14
# Donchian breakout channel lookback (bars).
FP_DONCHIAN_PERIOD=20
# Skip breakouts when ADX(14) is below this (0 disables the regime filter).
FP_REGIME_ADX_MIN=20
# Only take longs above this EMA and shorts below it (0 disables the filter).
FP_TREND_EMA=200
# Supertrend band (only used by FP_STRATEGY=supertrend).
FP_SUPERTREND_PERIOD=10
FP_SUPERTREND_MULT=3.0

# --- Risk ----------------------------------------------------------------
# Percent of account equity risked between entry and stop loss.
FP_RISK_PER_PCT=0.5
# Stop distance as a multiple of ATR.
FP_ATR_STOP_MULT=2.0
# Take profit as a multiple of the stop distance (reward:risk).
FP_TP_RR=2.0
# Exit management (evaluated once per closed candle; 0 disables each).
# Breakeven: at FP_BREAKEVEN_AT_R * R profit, move the stop to entry +/-
# FP_BREAKEVEN_PLUS_R * R. Suggested starting point: 1.0 / 0.1.
FP_BREAKEVEN_AT_R=0
FP_BREAKEVEN_PLUS_R=0.1
# ATR trailing stop: ratchet to peak -/+ FP_TRAIL_ATR_MULT * ATR.
# Suggested starting point: 3.0. The stop only ever tightens.
FP_TRAIL_ATR_MULT=0
FP_LEVERAGE=2
FP_MARGIN_MODE=cross
FP_MAX_DAILY_LOSS_PCT=2.0
FP_MAX_DAILY_TRADES=6
# Cumulative (whole-account) drawdown limit, independent of the API room
# figures. 0 disables it. The daily loss cap above resets every UTC day, so
# without this a bot-only live account has no guard against a multi-day slide.
# Default 3 matches the firm's static 3% floor on a 1-Step Select account, so
# the bot halts itself before the account's own limit is reached.
FP_MAX_TOTAL_DRAWDOWN_PCT=3
# Measure drawdown from the account starting balance ("starting") or from the
# highest equity ever seen, i.e. trailing ("peak").
FP_DRAWDOWN_BASIS=starting
# Explicitly accept running a live bot-only account with no cumulative drawdown
# guard (FP_MAX_TOTAL_DRAWDOWN_PCT=0). Only for dry runs or deliberate risk.
FP_ACK_NO_DRAWDOWN_GUARD=false
# Close open positions and stop when the remaining daily loss room falls
# below this percent of starting balance.
FP_MIN_DAILY_ROOM_PCT=0.5
# Cap total position margin (across all markets) as a percent of equity.
FP_MAX_MARGIN_PCT=50
# Max quote-vs-candle-close drift allowed before an entry is skipped, as a
# multiple of ATR. The 5% absolute cap always applies on top of this.
FP_MAX_ENTRY_DRIFT_ATR=0.5
# Flatten scope: "bot" closes only positions this bot opened; "account"
# closes every open position on the account.
FP_FLATTEN_SCOPE=bot

# What to do when the account risk snapshot reports no room figures
# (daily_loss_room / max_drawdown_room are null). "halt" refuses new entries
# (fail closed); "bot-only" keeps trading with the bot-side caps and logs a
# warning once per day. Empty = default by environment: "halt" on live,
# "bot-only" on sandbox.
FP_ON_MISSING_ROOM=

# --- Runtime -------------------------------------------------------------
FP_POLL_SECONDS=15
FP_LOG_LEVEL=INFO
# Timezone for the daily-guard day boundary. The firm resets the daily loss
# limit at midnight America/New_York; keep this unless you know better.
FP_DAY_TIMEZONE=America/New_York
# State file. A dry run uses "<FP_STATE_FILE>.dryrun" instead, so it never
# reads or writes the live state.
FP_STATE_FILE=bot_state.json
FP_DRY_RUN=false
