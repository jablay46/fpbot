# Copy this file to .env and fill in your values. Never commit .env.

# --- Credentials ---------------------------------------------------------
# Sandbox key (fp_test_...) for practice, live key (fp_live_...) for real
# challenge accounts. Each key only authenticates on its own host.
FP_API_KEY=fp_test_replace_me

# Environment: "sandbox" (default) or "live".
FP_ENV=sandbox

# --- Account & market ----------------------------------------------------
# Leave FP_ACCOUNT_ID empty to auto-select the first active account.
FP_ACCOUNT_ID=

# Multi-asset list. Comma-separated market IDs. When set, FP_MARKET_ID is
# ignored. Max 32 markets (one WebSocket subscription limit).
# Crypto / majors + stocks + indices + commodities + forex, for example:
FP_SYMBOLS=binance|BTCUSDT,binance|ETHUSDT,binance|SOLUSDT,binance|XRPUSDT,hyperliquid|xyz:AAPL,hyperliquid|xyz:SP500,binance|XAUUSDT,hyperliquid|xyz:EUR

# Fallback single market when FP_SYMBOLS is empty.
FP_MARKET_ID=binance|BTCUSDT

# --- Strategy ------------------------------------------------------------
FP_STRATEGY=ema_cross
FP_TIMEFRAME=15m
FP_EMA_FAST=12
FP_EMA_SLOW=26
FP_ATR_PERIOD=14

# --- Risk ----------------------------------------------------------------
# Percent of account equity risked between entry and stop loss.
FP_RISK_PER_PCT=0.5
# Stop distance as a multiple of ATR.
FP_ATR_STOP_MULT=2.0
# Take profit as a multiple of the stop distance (reward:risk).
FP_TP_RR=2.0
FP_LEVERAGE=2
FP_MARGIN_MODE=cross
FP_MAX_DAILY_LOSS_PCT=2.0
FP_MAX_DAILY_TRADES=6
# Close open positions and stop when the remaining daily loss room falls
# below this percent of starting balance.
FP_MIN_DAILY_ROOM_PCT=0.5
# Cap total position margin (across all markets) as a percent of equity.
FP_MAX_MARGIN_PCT=50
# Max quote-vs-candle-close drift allowed before an entry is skipped, as a
# multiple of ATR. The 5% absolute cap always applies on top of this.
FP_MAX_ENTRY_DRIFT_ATR=0.5
# Flatten scope: "bot" closes only positions this bot opened; "account"
# closes every open position on the account.
FP_FLATTEN_SCOPE=bot

# What to do when the account risk snapshot reports no room figures
# (daily_loss_room / max_drawdown_room are null). "halt" refuses new entries
# (fail closed); "bot-only" keeps trading with the bot-side caps and logs a
# warning once per day. Empty = default by environment: "halt" on live,
# "bot-only" on sandbox.
FP_ON_MISSING_ROOM=

# --- Runtime -------------------------------------------------------------
FP_POLL_SECONDS=15
FP_LOG_LEVEL=INFO
# State file. A dry run uses "<FP_STATE_FILE>.dryrun" instead, so it never
# reads or writes the live state.
FP_STATE_FILE=bot_state.json
FP_DRY_RUN=false
